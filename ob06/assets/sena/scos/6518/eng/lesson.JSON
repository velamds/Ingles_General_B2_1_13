ed": 0}]}, {"_data": [{"type": "question", "contents": [{"content": "<br>Jason</span>: Wow! I'll ", "type": "text"}]}, {"type": "incorrect", "contents": [{"content": "crossing ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "my fingers for you! <br>Amy</span>: Thanks!", "type": ""}}, {"content": "secondary_8", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "cross", "type": "text"}], "selected": 0}]}]}, {"id": 11, "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "type": "RSLT", "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn9le13ob06re2aud01", "images": [{"image": "engenn9le13ob06re2img05.jpg", "id": 0, "text": "Dear Mr. Bari,<br><br>Following your phone interview last week, it is my pleasure to invite you to a second interview at Never Odd Or Even. We would like to meet you on Thursday January 30th at 2:00 p.m. At that time, you will meet our publisher, Mr. Keller, and the head of web content, Ms. Andrews.<br><br>This on-site interview will take place at our offices at 35 Richmond Street, located at the corner of Birch Avenue.  <br><br>We would like you to prepare answers for the following questions:<br><br>1. Why do you want to be a web content editor?<br>\n2. When are you available to start working?<br>\n3. What is your expected salary?<br>\n4. How would you describe your writing style?<br><br>If you have any questions, please feel to contact me directly.<br><br>Yours sincerely,<br><br>Frank Mitchell", "time": "100"}, {"image": "engenn9le13ob06re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Adam</span>:  Hey, Kristi!  <br>\n<span class=\"strong\">Kristi</span>:  Hi, Adam. What's up?<br>\n<span class=\"strong\">Adam</span>:  Guess what? I'm going to have a second interview at Never Odd Or Even!<br>\n<span class=\"strong\">Kristi</span>: That's fantastic!  When is it?<br>\n<span class=\"strong\">Adam</span>: The interview is next Thursday. I'm meeting the publisher and the head of web content. They said I should prepare some questions in advance.<br>\n<span class=\"strong\">Kristi</span>: Oh yeah? That's great!  What are the questions?<br>\n<span class=\"strong\">Adam</span>: They asked me why I wanted to be a web content editor.<br>\n<span class=\"strong\">Kristi</span>: That should be an easy one. You like writing.<br>", "time": "60000"}, {"image": "engenn9le13ob06re2img07.jpg", "id": 2, "text": "<span class=\"strong\">Adam</span>:  Then they asked me when I was available to start working. They also asked me what my expected salary was.<br>\n<span class=\"strong\">Kristi</span>: What are you going to say?<br>\n<span class=\"strong\">Adam</span>:  I don't know yet. I'll have to think about it.  They asked me how I would describe my writing style. That's going to be a hard question.<br>\n<span class=\"strong\">Kristi</span>:  Oh, just say something like: fast and furious! <br>\n<span class=\"strong\">Adam</span>:  Or how about sweet and sumptuous?<br>", "time": "86500"}], "coverimg": "engenn9le13ob06re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}